{# Product Card Component #}
{# Usage: {% include "components/product-card.jinja2" with product=product %} #}

<article class="product-card">
    <a href="/products/{{ product.ID }}.jinja2" class="product-image">
        <div class="product-placeholder">{{ product.Name|first }}</div>
        {% if not product.InStock %}
        <span class="product-overlay">Out of Stock</span>
        {% endif %}
    </a>
    <div class="product-body">
        <span class="product-brand">{{ product.BrandName }}</span>
        <h3 class="product-title">
            <a href="/products/{{ product.ID }}.jinja2">{{ product.Name }}</a>
        </h3>
        <div class="product-footer">
            <span class="product-price">{{ product.Price|price }}</span>
            {% if product.InStock %}
            <span class="badge badge-success">In Stock</span>
            {% else %}
            <span class="badge badge-danger">Out of Stock</span>
            {% endif %}
        </div>
    </div>
</article>

<style>
    .product-card {
        background: white;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: all 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg);
    }

    .product-image {
        display: block;
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #f0f4ff 0%, #e0e7ff 100%);
    }

    .product-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        font-weight: bold;
        color: var(--primary);
        opacity: 0.5;
    }

    .product-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 1.125rem;
    }

    .product-body {
        padding: 20px;
    }

    .product-brand {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
        font-weight: 600;
    }

    .product-title {
        margin: 8px 0 16px;
        font-size: 1.125rem;
        font-weight: 600;
    }

    .product-title a {
        color: var(--dark);
    }

    .product-title a:hover {
        color: var(--primary);
    }

    .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .product-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--dark);
    }
</style>
